{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentAura PetDesktop",
  "version": "0.3.0",
  "identifier": "org.agentaura.petdesktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "AgentAura PetDesktop",
        "width": 1120,
        "height": 760,
        "minWidth": 820,
        "minHeight": 580,
        "center": true,
        "visible": true
      },
      {
        "label": "pet",
        "title": "AgentAura Pet",
        "url": "index.html?view=pet",
        "width": 220,
        "height": 240,
        "x": 40,
        "y": 40,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "windows": {
      "nsis": {
        "installMode": "both"
      }
    },
    "category": "DeveloperTool",
    "shortDescription": "Agent status desktop pet and AgentAura hardware bridge",
    "longDescription": "Displays AI agent states as a desktop pet and synchronizes them to AgentAura hardware.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}

{
  "name": "agent-aura-claude",
  "displayName": "AgentAura - Claude Ring Light",
  "description": "Sync Claude Code lifecycle events to AgentAura ESP32 Ring Light hardware",
  "version": "0.1.0",
  "author": "AgentAura",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "agent-aura-claude": "./bin/agent-aura-claude.js"
  },
  "files": [
    ".claude-plugin/**",
    "agent-aura-claude.config.example.json",
    "bin/**",
    "commands/**",
    "hooks/**",
    "out/**",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "build": "npm test",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "test": "npm run compile && node --test test/*.test.js",
    "prepare": "npm run compile",
    "prepack": "npm run compile"
  },
  "keywords": [
    "claude-code",
    "agentaura",
    "esp32",
    "ring-light",
    "hooks"
  ],
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  },
  "dependencies": {
    "serialport": "^12.0.0"
  }
}
